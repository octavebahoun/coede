    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.10.1",
    "motion": "^12.23.24",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
